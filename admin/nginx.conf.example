# PC28 Admin — Nginx 配置示例
# 保存为 /etc/nginx/sites-available/pc28-admin

server {
    listen 80;
    server_name admin.yourdomain.com;

    root /var/www/pc28-admin/public;
    index index.php;

    # 日志
    access_log /var/log/nginx/pc28-admin.access.log;
    error_log  /var/log/nginx/pc28-admin.error.log;

    # PHP
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
    }

    # Clean URL - 将所有请求指向 public/index.php（API 除外）
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Bot API 路由：/api/bot/* → public/api/bot.php
    location /api/bot {
        try_files $uri /api/bot.php?$query_string;
    }

    # 静态资源缓存
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # 安全头
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    # 禁止访问隐藏文件
    location ~ /\. {
        deny all;
    }

    # 禁止访问 src/
    location ^~ /src {
        deny all;
    }

    # HTTPS（申请证书后启用）
    # listen 443 ssl http2;
    # ssl_certificate /etc/ssl/certs/pc28-admin.crt;
    # ssl_certificate_key /etc/ssl/private/pc28-admin.key;
}

# HTTP → HTTPS 重定向（申请证书后取消注释）
